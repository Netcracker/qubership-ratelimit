{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://netcracker.com/ratelimit-operator/values.schema.json",
  "type": "object",
  "title": "The ratelimit-operator schema.",
  "description": "JSON Schema for the ratelimit-operator chart. The root stays open: the platform passes one parameter set to every chart of the application, so the service chart's blocks reach this schema and are ignored. The blocks this chart reads are closed.",
  "required": [
    "SERVICE_NAME",
    "IMAGE_REPOSITORY",
    "NAMESPACE",
    "TAG",
    "DEPLOYMENT_SESSION_ID",
    "REPLICAS",
    "CPU_REQUEST",
    "MEMORY_REQUEST",
    "CPU_LIMIT",
    "MEMORY_LIMIT"
  ],
  "properties": {
    "SERVICE_NAME": {
      "$id": "#/properties/SERVICE_NAME",
      "type": "string",
      "title": "The SERVICE_NAME schema",
      "description": "Name of a service.",
      "minLength": 1,
      "default": "ratelimit-operator",
      "internal": true,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "NAMESPACE": {
      "$id": "#/properties/NAMESPACE",
      "type": "string",
      "title": "The NAMESPACE schema",
      "description": "The namespace it is going to be deployed.",
      "internal": true,
      "minLength": 1
    },
    "APPLICATION_NAME": {
      "$id": "#/properties/APPLICATION_NAME",
      "type": "string",
      "title": "The APPLICATION_NAME schema",
      "description": "Defines application name",
      "default": "ratelimit",
      "examples": [
        "MyApplication"
      ],
      "internal": true
    },
    "MANAGED_BY": {
      "$id": "#/properties/MANAGED_BY",
      "type": "string",
      "title": "The MANAGED_BY schema",
      "description": "The tool being used to manage the operation of an application",
      "default": "Helm",
      "examples": [
        "helm",
        "operator",
        "argocd"
      ],
      "internal": true
    },
    "ARTIFACT_DESCRIPTOR_VERSION": {
      "$id": "#/properties/ARTIFACT_DESCRIPTOR_VERSION",
      "type": "string",
      "title": "The ARTIFACT_DESCRIPTOR_VERSION schema",
      "description": "Artifact descriptor version which is installed",
      "default": "",
      "internal": true
    },
    "DEPLOYMENT_SESSION_ID": {
      "$id": "#/properties/DEPLOYMENT_SESSION_ID",
      "type": "string",
      "title": "The DEPLOYMENT_SESSION_ID schema",
      "description": "Unique identifier of deployment session used to track e2e deploy activity",
      "examples": [
        "516736bf-d4b7-4900-beab-9599573ac8a8"
      ],
      "internal": true,
      "minLength": 1
    },
    "PAAS_PLATFORM": {
      "$id": "#/properties/PAAS_PLATFORM",
      "type": "string",
      "title": "The PAAS_PLATFORM schema",
      "description": "PaaS Platform.",
      "enum": [
        "KUBERNETES",
        "OPENSHIFT"
      ],
      "default": "KUBERNETES",
      "examples": [
        "KUBERNETES",
        "OPENSHIFT"
      ],
      "internal": true
    },
    "READONLY_CONTAINER_FILE_SYSTEM_ENABLED": {
      "$id": "#/properties/READONLY_CONTAINER_FILE_SYSTEM_ENABLED",
      "type": "boolean",
      "title": "The READONLY_CONTAINER_FILE_SYSTEM_ENABLED schema",
      "description": "Read-only container file system is enabled",
      "default": true,
      "examples": [
        false
      ]
    },
    "DEPLOYMENT_STRATEGY_TYPE": {
      "$id": "#/properties/DEPLOYMENT_STRATEGY_TYPE",
      "type": "string",
      "title": "The DEPLOYMENT_STRATEGY_TYPE schema",
      "description": "Specify Deployment Strategy type for deploying service",
      "enum": [
        "recreate",
        "best_effort_controlled_rollout",
        "ramped_slow_rollout",
        "custom_rollout"
      ],
      "examples": [
        "recreate",
        "best_effort_controlled_rollout",
        "ramped_slow_rollout",
        "custom_rollout"
      ]
    },
    "DEPLOYMENT_STRATEGY_MAXSURGE": {
      "$id": "#/properties/DEPLOYMENT_STRATEGY_MAXSURGE",
      "$ref": "#/definitions/integerOrString",
      "title": "The DEPLOYMENT_STRATEGY_MAXSURGE schema",
      "description": "Specify .spec.strategy.rollingUpdate.maxSurge parameter",
      "examples": [
        "50%",
        "2"
      ]
    },
    "DEPLOYMENT_STRATEGY_MAXUNAVAILABLE": {
      "$id": "#/properties/DEPLOYMENT_STRATEGY_MAXUNAVAILABLE",
      "$ref": "#/definitions/integerOrString",
      "title": "The DEPLOYMENT_STRATEGY_MAXUNAVAILABLE schema",
      "description": "Specify .spec.strategy.rollingUpdate.maxUnavailable parameter",
      "examples": [
        "50%",
        "2"
      ]
    },
    "LIVENESS_PROBE_INITIAL_DELAY_SECONDS": {
      "$id": "#/properties/LIVENESS_PROBE_INITIAL_DELAY_SECONDS",
      "type": "integer",
      "title": "The LIVENESS_PROBE_INITIAL_DELAY_SECONDS schema",
      "internal": true
    },
    "IMAGE_REPOSITORY": {
      "$id": "#/properties/IMAGE_REPOSITORY",
      "type": "string",
      "title": "The IMAGE_REPOSITORY schema",
      "minLength": 1,
      "default": "ghcr.io/netcracker/qubership-ratelimit-operator",
      "internal": true
    },
    "TAG": {
      "$id": "#/properties/TAG",
      "type": "string",
      "title": "The TAG schema",
      "internal": true,
      "minLength": 1
    },
    "LOG_LEVEL": {
      "$id": "#/properties/LOG_LEVEL",
      "type": "string",
      "title": "The LOG_LEVEL schema",
      "description": "Log level for service.",
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR"
      ],
      "default": "info",
      "examples": [
        "info",
        "debug",
        "warn"
      ],
      "internal": true
    },
    "MONITORING_ENABLED": {
      "$id": "#/properties/MONITORING_ENABLED",
      "type": "boolean",
      "title": "The MONITORING_ENABLED schema",
      "description": "Set to true to import dashboards to Grafana and configure integration with Prometheus. Requires Platform System Monitor CRDs to be deployed to target k8s/openshift cluster",
      "examples": [
        true,
        false
      ]
    },
    "policyAlerts": {
      "type": "object",
      "title": "Alert rules over the policy status",
      "description": "The PrometheusRule of the chart, rendered with MONITORING_ENABLED; the thresholds and hold durations the expressions read.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render the PrometheusRule over the policy status. Read only with MONITORING_ENABLED."
        },
        "stalledFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long a domain stays Stalled before RatelimitStalled fires."
        },
        "notReadyFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "30m",
          "description": "How long a policy stays not Ready before RatelimitNotReadyLong fires."
        },
        "ruleProblemsFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long a blocking problem stays on the latest generation before RatelimitRuleProblems fires."
        },
        "noReplicasFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long a domain has no ready service replica before RatelimitNoReplicas fires."
        },
        "checksStoppedWindow": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "10m",
          "description": "The window over which a domain enforced by ready replicas receiving no check fires RatelimitChecksStopped."
        },
        "checksStoppedFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "15m",
          "description": "How long a domain receives no check before RatelimitChecksStopped fires."
        },
        "configWriteFailingFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long the last write of the ConfigMap has failed before RatelimitConfigWriteErrors fires."
        },
        "notEnforcedFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long a policy enforces no generation before RatelimitNotEnforced fires."
        },
        "reconcileErrorsWindow": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "30m",
          "description": "The window over which a controller failing every reconcile fires RatelimitOperatorReconcileFailing; longer than the controller's longest retry backoff, 1000 seconds."
        },
        "noLeaderFor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$",
          "default": "5m",
          "description": "How long no operator pod holds the Lease before RatelimitNoOperatorLeader fires."
        }
      },
      "additionalProperties": false
    },
    "CLOUD_TOPOLOGY_KEY": {
      "$id": "#/properties/CLOUD_TOPOLOGY_KEY",
      "type": "string",
      "title": "The CLOUD_TOPOLOGY_KEY schema",
      "description": "Affinity key.",
      "minLength": 1,
      "default": "kubernetes.io/hostname",
      "examples": [
        "kubernetes.io/hostname"
      ]
    },
    "CLOUD_TOPOLOGIES": {
      "$id": "#/properties/CLOUD_TOPOLOGIES",
      "type": "array",
      "title": "Topologies settings for topologySpreadConstraints",
      "description": "Array of topologies settings for topologySpreadConstraints. Each array item must contain at least 'topologyKey' attribute. Other supported attributes are 'maxSkew' and 'whenUnsatisfiable' - optional.",
      "items": {
        "type": "object",
        "required": [
          "topologyKey"
        ],
        "properties": {
          "topologyKey": {
            "type": "string",
            "minLength": 1
          },
          "maxSkew": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "whenUnsatisfiable": {
            "type": "string",
            "enum": [
              "ScheduleAnyway",
              "DoNotSchedule"
            ],
            "default": "ScheduleAnyway"
          }
        }
      },
      "examples": [
        "- topologyKey: kubernetes.io/hostname"
      ],
      "internal": true
    },
    "REPLICAS": {
      "$id": "#/properties/REPLICAS",
      "$ref": "#/definitions/integerOrString",
      "title": "The REPLICAS schema",
      "internal": true,
      "envSpecific": true
    },
    "CPU_REQUEST": {
      "$id": "#/properties/CPU_REQUEST",
      "$ref": "#/definitions/integerOrString",
      "title": "The CPU_REQUEST schema",
      "internal": true,
      "envSpecific": true
    },
    "MEMORY_REQUEST": {
      "$id": "#/properties/MEMORY_REQUEST",
      "type": "string",
      "title": "The MEMORY_REQUEST schema",
      "description": "Defines minimum amount of memory the container will use to start",
      "examples": [
        "256Mi"
      ],
      "internal": true,
      "envSpecific": true
    },
    "CPU_LIMIT": {
      "$id": "#/properties/CPU_LIMIT",
      "$ref": "#/definitions/integerOrString",
      "title": "The CPU_LIMIT schema",
      "internal": true,
      "envSpecific": true
    },
    "MEMORY_LIMIT": {
      "$id": "#/properties/MEMORY_LIMIT",
      "type": "string",
      "title": "The MEMORY_LIMIT schema",
      "internal": true,
      "envSpecific": true
    },
    "BASELINE_ORIGIN": {
      "$id": "#/properties/BASELINE_ORIGIN",
      "type": "string",
      "title": "The BASELINE_ORIGIN schema",
      "description": "Baseline Blue-Green Origin namespace name: a namespace, written as Kubernetes writes it, or empty.",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63,
      "default": "",
      "examples": [
        "baseline-origin"
      ]
    }
  },
  "definitions": {
    "integerOrString": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "numberOrString": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
