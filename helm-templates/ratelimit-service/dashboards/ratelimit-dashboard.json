{
  "uid": "dashboard-uid-placeholder",
  "title": "Rate Limit - namespace-default-placeholder",
  "description": "Rate limiting at the mesh gateways: verdicts, latency against the filter timeout, budget headroom, and policy status.",
  "tags": [
    "ai-generated",
    "ratelimit",
    "k8s"
  ],
  "schemaVersion": 41,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "tags": [
        "k8s"
      ],
      "includeVars": true,
      "keepTime": true,
      "targetBlank": true,
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ratelimit_snapshot_timestamp_seconds, cluster)",
        "refresh": 2,
        "allValue": ".*",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ratelimit_snapshot_timestamp_seconds{cluster=~\"$cluster\"}, namespace)",
        "refresh": 2,
        "allValue": ".*",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "filter",
        "type": "adhoc",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "baseFilters": [],
        "filters": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Check rate",
      "description": "Rate limit checks per second across the service, every verdict included.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Refused share",
      "description": "Share of checks answered over_limit. High is not wrong by itself - limits refusing is limits working - but a jump is where an incident review starts.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\", verdict=\"over_limit\"}[$__rate_interval])) / sum(rate(ratelimit_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failure-mode checks",
      "description": "Checks the gateway's failure mode decided instead of a limit: the store was unreachable. With fail-open this traffic passed unlimited.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\", verdict=\"unavailable\"}[$__rate_interval])) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unknown-domain checks",
      "description": "Checks for domains no RateLimitPolicy claims: the gateway filter config and the custom resources drifted apart, and this traffic passes unlimited. The domain name is in the service log.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_unknown_domain_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Policies not ready",
      "description": "Policies whose latest generation is not the one enforced. The reason label on ratelimit_policy_ready says why; an edit stuck on last-good hides here.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (domain) (ratelimit_policy_ready{cluster=~\"$cluster\", namespace=~\"$namespace\"}) == 0) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Store error rate",
      "description": "Failed counter store decisions. Sustained errors mean the limiter is running on the gateway's failure mode, whichever way that is set.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_store_errors_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Decisions",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checks by verdict",
      "description": "Every check by its final verdict. The unavailable band is the failure-mode exposure window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(ratelimit_checks_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Refusals by rule",
      "description": "Which rules refuse, at what rate. The rule label is the block/rule pair, the same identity the counter key carries.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (rate(ratelimit_decisions_total{cluster=~\"$cluster\", namespace=~\"$namespace\", outcome=\"over_limit\"}[$__rate_interval])))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Near-limit admissions by rule",
      "description": "Admissions inside the configured margin of their rule's limit - the precursor of refusals, hours before clients notice.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (rate(ratelimit_near_limit_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Shadow refusals by rule",
      "description": "What shadow rules would have refused. The number that says whether a dry-run limit is safe to enforce.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (rate(ratelimit_decisions_total{cluster=~\"$cluster\", namespace=~\"$namespace\", outcome=\"shadow_over_limit\"}[$__rate_interval])))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Latency and store",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Check duration",
      "description": "Full time of one check - what the gateway waits for before its filter timeout fails open or closed. The line marks the 10ms decision budget.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, domain) (rate(ratelimit_check_duration_seconds_bucket{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99 {{domain}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, domain) (rate(ratelimit_check_duration_seconds_bucket{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 {{domain}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Store roundtrip",
      "description": "The counter store's share of the check, per domain. A domain is pinned to one Redis Cluster slot, so a rising p99 here is that shard saturating.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, domain) (rate(ratelimit_store_roundtrip_seconds_bucket{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99 {{domain}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, domain) (rate(ratelimit_store_roundtrip_seconds_bucket{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 {{domain}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Store errors by reason",
      "description": "timeout is load or distance, server is the store answering an error - a script or command problem no retry cures - and other is connectivity.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(ratelimit_store_errors_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Token cache hit ratio",
      "description": "Share of identity extractions the cache avoided. A drop means the cache is undersized for the client population - or someone is minting fresh tokens per request.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_token_cache_hits_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])) / (sum(rate(ratelimit_token_cache_hits_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])) + sum(rate(ratelimit_token_cache_misses_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Configuration and capacity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 18,
      "type": "state-timeline",
      "title": "Policy readiness",
      "description": "Ready means the latest generation of the policy is the one enforced. A policy that turns red kept or lost its previous generation - the stat above counts them, the reason label names why.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NotReady",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (domain) (ratelimit_policy_ready{cluster=~\"$cluster\", namespace=~\"$namespace\"})",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Replicas enforcing the active generation",
      "description": "Per domain, the ready replicas that enforce the active generation against the ready fleet, as the operator judged it on its last probe. The two lines apart is a rollout or a projection in flight; apart past the propagation deadline is Stalled.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain) (ratelimit_policy_replicas{cluster=~\"$cluster\", namespace=~\"$namespace\", state=\"applied\"})",
          "legendFormat": "{{domain}} applied"
        },
        {
          "refId": "B",
          "expr": "max by (domain) (ratelimit_policy_replicas{cluster=~\"$cluster\", namespace=~\"$namespace\", state=\"total\"})",
          "legendFormat": "{{domain}} ready"
        }
      ]
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Lowest enforced generation per domain",
      "description": "The lowest generation any ready replica enforces for the domain, across the fleet. A replica that fell behind shows as the fleet's floor here while the operator reports the domain Propagating or Stalled; the replicas panel above says how many are behind.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, min by (domain) (ratelimit_policy_applied_generation{cluster=~\"$cluster\", namespace=~\"$namespace\"}))",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Configuration plane errors",
      "description": "Refused configurations leave the replica serving the one it applied last, silently: a manifest or a payload it would not read. Write errors mean the operator could not save the namespace's configuration, so the replicas keep the previous one and the last-good fallback a restart would need is not being saved; the status reports it as ReplicaStale 90 s later. Too-large is the one generation that compiles and does not fit, held on last-good.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_snapshot_rebuilds_total{cluster=~\"$cluster\", namespace=~\"$namespace\", result=\"refused\"}[$__rate_interval]))",
          "legendFormat": "refused configurations"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(ratelimit_config_write_errors_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "write {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(ratelimit_policy_stalled{cluster=~\"$cluster\", namespace=~\"$namespace\", reason=\"ConfigMapTooLarge\"})",
          "legendFormat": "too large"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Last snapshot swap",
      "description": "When a replica last swapped its rule set, latest across the fleet: the forensic answer to whether the rules moved right before an incident.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ratelimit_snapshot_timestamp_seconds{cluster=~\"$cluster\", namespace=~\"$namespace\"}) * 1000",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Domain worst case, buckets",
      "description": "Worst-case buckets one request can collect across the domain, against the budget of 128. The operator refuses a generation past it as DomainBudgetExceeded and keeps the last-good one running, so this is the headroom an edit has left.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 128,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 128
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain) (ratelimit_domain_decision_buckets{cluster=~\"$cluster\", namespace=~\"$namespace\"})",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "Domain blocks",
      "description": "Compiled blocks of the domain. Observed rather than bounded: the object size keeps the target scan cheap on its own, so this is a number to watch, not a cap.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain) (ratelimit_domain_blocks{cluster=~\"$cluster\", namespace=~\"$namespace\"})",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 28,
      "type": "bargauge",
      "title": "Domain rules",
      "description": "Compiled rules of the domain across its blocks, the count the snapshot endpoint's summary reports. Observed, like the blocks.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain) (ratelimit_domain_rules{cluster=~\"$cluster\", namespace=~\"$namespace\"})",
          "legendFormat": "{{domain}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "state-timeline",
      "title": "Stalled domains",
      "description": "Whether the operator judges a domain stuck rather than progressing, and which way: a replica behind past the deadline, a manifest format a replica does not read, or a generation that does not fit the ConfigMap. Ready above turns False for the same domain; this is the reason.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Progressing",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Stalled",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (domain, reason) (ratelimit_policy_stalled{cluster=~\"$cluster\", namespace=~\"$namespace\"})",
          "legendFormat": "{{domain}} {{reason}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Versions in the fleet",
      "description": "Pods per component and build, from ratelimit_build_info. Two versions of one component is a rollout in progress; the service ahead of the operator is a replica that may read a manifest the operator wrote in an older format.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Component",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "component": "Component",
              "version": "Version",
              "Value": "Pods"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "count by (component, version) (ratelimit_build_info{cluster=~\"$cluster\", namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Lease holder",
      "description": "The operator pod that holds the Lease: the one writing the ConfigMap and the policy status, and the one whose scrape carries the fleet series. None means no operator is elected and nothing is being reconciled.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (ratelimit_leader{cluster=~\"$cluster\", namespace=~\"$namespace\"} == 1)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "row",
      "title": "Extraction",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "collapsed": true,
      "panels": [
        {
          "id": 24,
          "type": "timeseries",
          "title": "Extraction skips by domain, key, and reason",
          "description": "Identity extraction anomalies, per domain and declared key. A steady band of decode_failed next to normal traffic means the tokens changed shape and clients are folding into one shared bucket; the domain says whose mapping to read.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 73
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "decimals": 1,
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 10,
                "showPoints": "never"
              }
            }
          },
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "max"
              ],
              "sortBy": "Last *",
              "sortDesc": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (domain, key, reason) (rate(ratelimit_extraction_skips_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
              "legendFormat": "{{domain}} {{key}}/{{reason}}"
            }
          ]
        },
        {
          "id": 25,
          "type": "timeseries",
          "title": "Extractions by domain and key",
          "description": "Decisions whose request carried a value for the declared key, per domain. Seeded at zero on every apply: a key flat at zero while the domain's checks flow is a dead claim path, a mapping that names a claim the tokens do not carry.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 73
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "decimals": 1,
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 10,
                "showPoints": "never"
              }
            }
          },
          "options": {
            "legend": {
              "showLegend": true,
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull",
                "max"
              ],
              "sortBy": "Last *",
              "sortDesc": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (domain, key) (rate(ratelimit_extractions_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__rate_interval]))",
              "legendFormat": "{{domain}} {{key}}"
            }
          ]
        }
      ]
