lor=#F6F8F5;fontSize=10.5;fontStyle=1;resizable=0;" vertex="1" connectable="0" parent="e8b"><mxGeometry x="0" width="20" height="20" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e8c" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1F7A4D;strokeWidth=2.6;exitX=0.91;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.107;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw-oss" target="service"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="396" /></Array></mxGeometry></mxCell><mxCell id="e8c-n" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F7A4D;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#F6F8F5;fontSize=10.5;fontStyle=1;resizable=0;" vertex="1" connectable="0" parent="e8c"><mxGeometry x="0" width="20" height="20" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1F7A4D;strokeWidth=2.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="service" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9-n" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F7A4D;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#F6F8F5;fontSize=10.5;fontStyle=1;resizable=0;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" width="20" height="20" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e10a" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5C6B62;strokeWidth=1.4;dashed=1;dashPattern=5 4;exitX=0.283;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="helm" target="gw-bss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10a-n" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#5C6B62;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#F6F8F5;fontSize=10.5;fontStyle=1;resizable=0;" vertex="1" connectable="0" parent="e10a"><mxGeometry x="0" width="20" height="20" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e10b" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#5C6B62;strokeWidth=1.4;dashed=1;dashPattern=5 4;exitX=0.717;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="helm" target="gw-oss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10b-n" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#5C6B62;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#F6F8F5;fontSize=10.5;fontStyle=1;resizable=0;" vertex="1" connectable="0" parent="e10b"><mxGeometry x="0" width="20" height="20" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="legend" value="&lt;div style=&quot;line-height:1.55&quot;&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#5C6B62;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;1&lt;/span&gt;&amp;nbsp; The team applies &lt;b&gt;RateLimitPolicy&lt;/b&gt;; the API server checks the object shape on apply, the operator's compiler reports the content through the status.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1C2420;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;2&lt;/span&gt;&amp;nbsp; The operator's informer on its own namespace: strict decode, compile, size check against the 1 MiB of a ConfigMap.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1C2420;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;3&lt;/span&gt;&amp;nbsp; The operator writes the status: Ready / Stalled, from the generations the replicas report.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1C2420;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;4&lt;/span&gt;&amp;nbsp; The operator writes &lt;b&gt;ratelimit-config&lt;/b&gt; whole on every reconcile: one &amp;lt;domain&amp;gt;.json.gz per domain plus the manifest; the ConfigMap is the last-good state.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1C2420;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;5&lt;/span&gt;&amp;nbsp; The kubelet projects the ConfigMap into every service replica within its sync period; the replica decodes, compiles, and swaps its snapshot. A replica is Ready only after its first apply.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1C2420;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;6&lt;/span&gt;&amp;nbsp; The operator reads /debug/applied of every ready replica every 10 s through the EndpointSlice of the Service, port name metrics: the strict Ready.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1F7A4D;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;7&lt;/span&gt;&amp;nbsp; Clients: HTTP through any gateway of the composite; the verdict comes back as 200 / 429.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1F7A4D;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;8&lt;/span&gt;&amp;nbsp; Every gateway calls the baseline service: gRPC ShouldRateLimit on ratelimit:9000.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#1F7A4D;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;9&lt;/span&gt;&amp;nbsp; One atomic Lua call charges the counters in Redis.&lt;br&gt;&lt;span style=&quot;display:inline-block;width:18px;height:18px;line-height:18px;border-radius:9px;background:#5C6B62;color:#F6F8F5;font-weight:bold;text-align:center;font-size:10.5px&quot;&gt;10&lt;/span&gt;&amp;nbsp; The operator chart on every namespace deploy places the EnvoyFilter in its own namespace, with the RLS address computed from the baseline name; the service chart renders nothing in a satellite.&lt;br&gt;&lt;span style=&quot;color:#5C6B62&quot;&gt;Lines: dashed grey = placed by people and helm · thin dark = control plane · thick green = request path&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=11;verticalAlign=top;fontColor=#1C2420;spacing=6;" vertex="1" parent="1"><mxGeometry x="28" y="790" width="1104" height="250" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>